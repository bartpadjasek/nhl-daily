# Copy to .env for local runs. On GitHub, add these as repository secrets instead.

# Email delivery (required)
RESEND_API_KEY=re_your_key_here
TO_EMAIL=you@example.com

# Model provider: set only the key for the provider in config.toml [llm]
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_API_KEY=            # openai_compatible servers that need a key (OpenRouter, Groq, ...)

# Optional: weather for the next game's city on the Next Up card
OPENWEATHERMAP_API_KEY=
